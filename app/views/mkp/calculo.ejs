<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MKP - Cálculo de Custos</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="nav">
    <a href="/mkp/calculo"><strong>MKP</strong></a>
    <a href="/mkp/calculo">Cálculo</a>
    <a href="/mkp/sobre">Sobre</a>
    <a href="/mkp/help">Help</a>
    <a href="/mkp/logout">Sair</a>
  </nav>

  <div class="container">
    <h2>Cálculo de Custos</h2>
    <p>Bem-vindo, <strong><%= user.nome %></strong></p>

    <form id="formCusto">
      <div class="form-group">
        <label for="custosDiretos">Custos Diretos (R$)</label>
        <input type="number" id="custosDiretos" name="custosDiretos" step="0.01" required>
      </div>
      <div class="form-group">
        <label for="custosIndiretos">Custos Indiretos (R$)</label>
        <input type="number" id="custosIndiretos" name="custosIndiretos" step="0.01" required>
      </div>
      <button type="submit" class="btn">Calcular</button>
    </form>

    <div class="result-box" id="resultado">
      <h3>Resultado</h3>
      <p>Custos Diretos: R$ <span id="resDiretos">-</span></p>
      <p>Custos Indiretos: R$ <span id="resIndiretos">-</span></p>
      <p><strong>Custo Total: R$ <span id="resTotal">-</span></strong></p>
    </div>
  </div>

  <script>
    document.getElementById('formCusto').addEventListener('submit', async (e) => {
      e.preventDefault();
      const custosDiretos = parseFloat(document.getElementById('custosDiretos').value);
      const custosIndiretos = parseFloat(document.getElementById('custosIndiretos').value);

      try {
        const res = await fetch('/api/mkp/custos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ custosDiretos, custosIndiretos })
        });
        const data = await res.json();

        if (data.erro) {
          alert(data.erro);
          return;
        }

        document.getElementById('resDiretos').textContent = data.custosDiretos.toFixed(2);
        document.getElementById('resIndiretos').textContent = data.custosIndiretos.toFixed(2);
        document.getElementById('resTotal').textContent = data.custoTotal.toFixed(2);
        document.getElementById('resultado').style.display = 'block';
      } catch (err) {
        alert('Erro ao calcular: ' + err.message);
      }
    });
  </script>
</body>
</html>
